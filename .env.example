# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# On Vercel add the same names under Project > Settings > Environment Variables.

# --- Database (MongoDB Atlas) ---
MONGODB_URI=

# --- Admin login ---
# Random text, at least 32 characters (96 recommended). Changing it logs everyone out.
JWT_SECRET=
# Only this email may create the admin account at /admin/setup.
# Set it on the live site. Leave empty only while you set the account up yourself.
ADMIN_EMAIL=

# --- Images (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP, for admin OTP codes and contact form messages) ---
# Gmail: smtp.gmail.com / 465 / your address / a Google "app password".
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
# Optional sender name, e.g. "Brescia Lions" <you@gmail.com>
EMAIL_FROM=

# --- Public website address ---
# The real address, no trailing slash. Used for links, sharing and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Search engines may list the site only when this is exactly "true".
# Set it on launch day, not before.
ALLOW_INDEXING=

# --- Local testing only (never set on the live site) ---
# MAIL_MODE=console   prints emails in the terminal instead of sending them
